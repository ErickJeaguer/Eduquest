# ==========================================
# Eduquest - Environment Configuration
# ==========================================

# Google Gemini API Key
# Obten tu clave de API en Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Configured Gemini Model (e.g., gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Backend Server Port
PORT=3000
